# Production. Every secret comes from the secret manager, never from the repo.
ENVIRONMENT=production
DEBUG=false
ENABLE_DOCS=false

# API runtime role: SELECT+INSERT only on audit_event (docker/postgres/audit_grants.sql).
DATABASE_URL=postgresql+asyncpg://aero_app:CHANGE_ME@postgres:5432/aero
# Owner role, used only by `alembic upgrade head` at start-up.
MIGRATION_DATABASE_URL=postgresql+asyncpg://aero:CHANGE_ME@postgres:5432/aero

POSTGRES_USER=aero
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aero
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

ALLOWED_ORIGINS=https://aeronaves.example.com

# Shared store is mandatory with more than one replica/worker.
REDIS_URL=redis://redis:6379/0
TRUST_FORWARDED_FOR=true

# Required to seed users in production; they must change it at first login.
SEED_USER_PASSWORD=
SENTRY_DSN=

# Attachments. BLACKBOX_MODE=fake is refused in production.
BLACKBOX_MODE=real
BLACKBOX_BASE_URL=https://blackboxve.store
BLACKBOX_MAESTRO_TOKEN=
BLACKBOX_TIMEOUT_SECONDS=15
# anthropic | off  (fake is never served in production)
RECEIPT_READER=off
ANTHROPIC_API_KEY=

# Throttling of costly endpoints (receipt reading, uploads, passenger search): per account AND per IP,
# fixed window. Counters share REDIS_URL with the login limiter.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXTRACT_PER_ACCOUNT=20
RATE_LIMIT_EXTRACT_PER_IP=60
RATE_LIMIT_UPLOAD_PER_ACCOUNT=60
RATE_LIMIT_UPLOAD_PER_IP=180
RATE_LIMIT_SEARCH_PER_ACCOUNT=60
RATE_LIMIT_SEARCH_PER_IP=180
RATE_LIMIT_EXPORT_PER_ACCOUNT=10
RATE_LIMIT_EXPORT_PER_IP=30
RATE_LIMIT_IMPORT_PER_ACCOUNT=10
RATE_LIMIT_IMPORT_PER_IP=30
RATE_LIMIT_AUDIT_SEARCH_PER_ACCOUNT=60
RATE_LIMIT_AUDIT_SEARCH_PER_IP=180
RATE_LIMIT_HEAVY_LIST_PER_ACCOUNT=240
RATE_LIMIT_HEAVY_LIST_PER_IP=720

# Idempotency-Key replay window and how often expired rows are swept.
IDEMPOTENCY_TTL_SECONDS=604800
IDEMPOTENCY_PURGE_INTERVAL_SECONDS=600

# Retention (days, 0 = off). Run by cron: see docs/RETENCION.md.
NOTIFICATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
AUDIT_RETENTION_FLOOR_DAYS=90
AUDIT_ARCHIVE_DIR=audit-archive
AUDIT_EXPORT_MAX_ROWS=50000
PASSENGER_RETENTION_DAYS=1095
UPLOAD_INTENT_STALE_HOURS=24
# Privileged role of the audit archive script ONLY (docker/postgres/audit_maintenance.sql). Never the API's.
MAINTENANCE_DATABASE_URL=postgresql+asyncpg://aero_maint:CHANGE_ME@postgres:5432/aero
