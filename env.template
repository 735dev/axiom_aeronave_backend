# Local development. Copy to .env. Production values live in env.production.template.
PROJECT_NAME=Aeronaves Backend
ENVIRONMENT=local
DEBUG=false

# Runtime connection (in Docker use host "postgres" and port 5432).
DATABASE_URL=postgresql+asyncpg://aero:aero@localhost:5440/aero
# Owner connection used only by Alembic. Optional locally.
#MIGRATION_DATABASE_URL=postgresql+asyncpg://aero:aero@localhost:5440/aero

# Postgres container init (docker compose).
POSTGRES_USER=aero
POSTGRES_PASSWORD=aero
POSTGRES_DB=aero
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Auth. Leave JWT_SECRET empty locally to get an ephemeral one (tokens die on restart).
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS: explicit origins, never "*".
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Login throttling (per account and per IP). REDIS_URL empty = in-process memory.
LOGIN_MAX_FAILS_PER_EMAIL=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_LOCK_SECONDS=900
REDIS_URL=
TRUST_FORWARDED_FOR=false

BUSINESS_TIMEZONE=America/Caracas

# Demo users from seeds.json get "demo1234" when this is empty (never in production).
SEED_USER_PASSWORD=

SENTRY_DSN=

# Attachments: fake = in-process Blackbox / reader (dev and tests only).
BLACKBOX_MODE=fake
BLACKBOX_BASE_URL=
BLACKBOX_MAESTRO_TOKEN=
BLACKBOX_TIMEOUT_SECONDS=15
# Official Bs/USD rate proposed on the operation form (real | fake | off). fake is refused in production.
EXCHANGE_RATE_MODE=real
EXCHANGE_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
RECEIPT_READER=fake
ANTHROPIC_API_KEY=

# Throttling of costly endpoints (receipt reading, uploads, passenger search): per account AND per IP,
# fixed window. Counters share REDIS_URL with the login limiter.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXTRACT_PER_ACCOUNT=20
RATE_LIMIT_EXTRACT_PER_IP=60
RATE_LIMIT_UPLOAD_PER_ACCOUNT=60
RATE_LIMIT_UPLOAD_PER_IP=180
RATE_LIMIT_SEARCH_PER_ACCOUNT=60
RATE_LIMIT_SEARCH_PER_IP=180
RATE_LIMIT_EXPORT_PER_ACCOUNT=10
RATE_LIMIT_EXPORT_PER_IP=30
RATE_LIMIT_IMPORT_PER_ACCOUNT=10
RATE_LIMIT_IMPORT_PER_IP=30
RATE_LIMIT_AUDIT_SEARCH_PER_ACCOUNT=60
RATE_LIMIT_AUDIT_SEARCH_PER_IP=180
RATE_LIMIT_HEAVY_LIST_PER_ACCOUNT=240
RATE_LIMIT_HEAVY_LIST_PER_IP=720

# Idempotency-Key replay window and how often expired rows are swept.
IDEMPOTENCY_TTL_SECONDS=604800
IDEMPOTENCY_PURGE_INTERVAL_SECONDS=600

# Retention (days, 0 = off). Run by cron: see docs/RETENCION.md.
NOTIFICATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
AUDIT_RETENTION_FLOOR_DAYS=90
AUDIT_ARCHIVE_DIR=audit-archive
AUDIT_EXPORT_MAX_ROWS=50000
PASSENGER_RETENTION_DAYS=1095
UPLOAD_INTENT_STALE_HOURS=24
# Privileged role of the audit archive script only (docker/postgres/audit_maintenance.sql).
#MAINTENANCE_DATABASE_URL=postgresql+asyncpg://aero_maint:aero@localhost:5440/aero
